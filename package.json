{
  "name": "subi",
  "displayName": "Subi",
  "description": "Subi - Software Development Assistant (Stage 1: UI Shell)",
  "version": "0.0.1",
  "publisher": "learnsmart",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "subi",
          "title": "Subi",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "subi": [
        {
          "id": "subi.sidebar",
          "name": "Subi",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "subi.configureAIProvider",
        "title": "Subi: Configure AI Provider"
      },
      {
        "command": "subi.removeAIProviderKey",
        "title": "Subi: Remove AI Provider Key"
      },
      {
        "command": "subi.setOpenRouterApiKey",
        "title": "Subi: Set OpenRouter API Key"
      },
      {
        "command": "subi.clearOpenRouterApiKey",
        "title": "Subi: Clear OpenRouter API Key"
      }
    ]
  },
  "activationEvents": [
    "onView:subi.sidebar"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test \"out/services/managed/__tests__/*.test.js\" \"out/agent/__tests__/*.test.js\" \"out/slash/__tests__/*.test.js\" \"out/tools/__tests__/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.14",
    "firebase": "^12.18.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.5",
    "marked": "^18.0.11"
  }
}
