[
  {
    "type": "function",
    "function": {
      "name": "coordination_submit",
      "description": "Operate on an owned coordination plan with current host authority and revision.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "nodes"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "nodeId",
                "title",
                "goal",
                "profile",
                "scope",
                "dependsOn",
                "required",
                "acceptanceRefs"
              ],
              "properties": {
                "nodeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "goal": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "profile": {
                  "type": "string",
                  "enum": [
                    "explore",
                    "plan",
                    "implement",
                    "review",
                    "test",
                    "debug"
                  ]
                },
                "customRoleId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                "scope": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "rootId",
                    "files",
                    "dirs",
                    "symbols"
                  ],
                  "properties": {
                    "rootId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "minItems": 0,
                      "maxItems": 100
                    },
                    "dirs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "minItems": 0,
                      "maxItems": 100
                    },
                    "symbols": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "minItems": 0,
                      "maxItems": 100
                    }
                  }
                },
                "dependsOn": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "minItems": 0,
                  "maxItems": 10
                },
                "required": {
                  "type": "boolean"
                },
                "acceptanceRefs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  },
                  "minItems": 0,
                  "maxItems": 30
                }
              }
            },
            "minItems": 2,
            "maxItems": 30
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "coordination_get",
      "description": "Operate on an owned coordination plan with current host authority and revision.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "planId"
        ],
        "properties": {
          "planId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "coordination_review",
      "description": "Operate on an owned coordination plan with current host authority and revision.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "planId",
          "expectedRevision",
          "planRevision",
          "nodeId",
          "jobId",
          "attemptId",
          "jobRevision",
          "decision",
          "reason"
        ],
        "properties": {
          "planId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "planRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "nodeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "jobId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "attemptId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "jobRevision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "decision": {
            "type": "string",
            "enum": [
              "accept",
              "reject"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 0,
            "maxLength": 500
          }
        }
      }
    }
  },
